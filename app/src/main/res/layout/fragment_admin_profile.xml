<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FAFAFA">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Pengaturan Admin"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:layout_marginBottom="24dp"/>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="#E0E0E0"
        app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center">

            <ImageView
                android:layout_width="79dp"
                android:layout_height="100dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/logosman1wanayasa"
                android:padding="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Administrator Sekolah"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#212121"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tv_admin_nisn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ID Admin: -"
                android:textSize="14sp"
                android:textColor="#757575"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Tombol Unduh Laporan -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_unduh_laporan"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Unduh Laporan Data (Excel)"
        android:textSize="16sp"
        app:cornerRadius="16dp"
        app:backgroundTint="#4CAF50"
        app:icon="@android:drawable/ic_menu_save"
        android:layout_marginBottom="12dp"/>

    <!-- Tombol Reset Tahun Ajaran -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_reset_sistem"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Reset Tahun Ajaran (Hapus Data)"
        android:textSize="16sp"
        app:cornerRadius="16dp"
        app:backgroundTint="#FF9800"
        app:icon="@android:drawable/ic_menu_delete"
        android:layout_marginBottom="32dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_logout_admin"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Keluar Sistem (Logout)"
        android:textSize="16sp"
        app:cornerRadius="16dp"
        app:backgroundTint="#FFEBEE"
        android:textColor="#D32F2F"
        app:strokeWidth="1dp"
        app:strokeColor="#FFCDD2"
        app:icon="@android:drawable/ic_menu_revert"
        app:iconTint="#D32F2F"/>

</LinearLayout>